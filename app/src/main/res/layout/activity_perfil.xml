<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".PerfilActivity">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/NavbarLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/spacing_xl">

            <!-- Header con degradé -->
            <LinearLayout
                android:id="@+id/perfilHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_profile_header"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="@dimen/spacing_xl"
                android:paddingBottom="@dimen/spacing_xl">

                <FrameLayout
                    android:layout_width="@dimen/avatar_size"
                    android:layout_height="@dimen/avatar_size"
                    android:layout_marginBottom="@dimen/spacing_sm"
                    android:background="@drawable/bg_avatar">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_person" />
                </FrameLayout>

                <TextView
                    android:id="@+id/perfilNombre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:textSize="@dimen/h2_text_size"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/perfilUsername"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white_translucent"
                    android:textSize="@dimen/caption_text_size" />

                <TextView
                    android:id="@+id/perfilProvincia"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:drawablePadding="@dimen/spacing_xs"
                    android:gravity="center_vertical"
                    android:textColor="@color/white_translucent"
                    android:textSize="@dimen/caption_text_size"
                    app:drawableStartCompat="@drawable/ic_location" />

                <TextView
                    android:id="@+id/perfilEstrellas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:letterSpacing="0.2"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- Estadísticas (se superponen al header) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-24dp"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/spacing_md">

                <LinearLayout
                    style="@style/StatCard.Tcg"
                    android:layout_marginEnd="@dimen/spacing_sm">

                    <TextView
                        android:id="@+id/statCartas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text"
                        android:textSize="@dimen/h3_text_size"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/stat_cartas"
                        android:textColor="@color/text_muted"
                        android:textSize="@dimen/caption_text_size" />
                </LinearLayout>

                <LinearLayout
                    style="@style/StatCard.Tcg"
                    android:layout_marginEnd="@dimen/spacing_sm">

                    <TextView
                        android:id="@+id/statResenas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text"
                        android:textSize="@dimen/h3_text_size"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/stat_resenas"
                        android:textColor="@color/text_muted"
                        android:textSize="@dimen/caption_text_size" />
                </LinearLayout>

                <LinearLayout style="@style/StatCard.Tcg">

                    <TextView
                        android:id="@+id/statMiembroDesde"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text"
                        android:textSize="@dimen/h3_text_size"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/stat_miembro_desde"
                        android:textColor="@color/text_muted"
                        android:textSize="@dimen/caption_text_size" />
                </LinearLayout>
            </LinearLayout>

            <!-- Acciones -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/spacing_md">

                <TextView
                    android:id="@+id/editarPerfilButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_secondary"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/editar_perfil"
                    android:textColor="@color/primary"
                    android:textSize="@dimen/body_text_size"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/cerrarSesionButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_danger"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/cerrar_sesion"
                    android:textColor="@color/white"
                    android:textSize="@dimen/body_text_size"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:layout_marginTop="@dimen/spacing_lg"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:text="@string/resenas_recibidas"
                android:textColor="@color/text"
                android:textSize="@dimen/h3_text_size"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/sinResenasTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="@dimen/spacing_xl"
                android:text="@string/sin_resenas"
                android:textColor="@color/text"
                android:textSize="@dimen/body_text_size"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/NavbarLayout"
        layout="@layout/navbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
